# Use a slim Alpine version of Python to keep the image size and attack surface small
FROM python:3.11-alpine

# Set the working directory inside the container
WORKDIR /app

# 1. Upgrade all Alpine OS packages, pull patched musl & sqlite-libs from edge, and install tzdata (for zoneinfo)
# 2. Remove bundled ensurepip wheels
# 3. Install latest patched application dependencies
# 4. Uninstall pip, setuptools, and wheel (removes build tools and vendored SBOMs)
# 5. Create a non-root user and persistent data directory
RUN (apk upgrade --no-cache || apk upgrade --no-cache) \
    && (apk upgrade --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main musl musl-utils sqlite-libs \
        || apk upgrade --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main musl musl-utils sqlite-libs) \
    && apk add --no-cache tzdata \
    && rm -rf /usr/local/lib/python*/ensurepip \
    && pip3 install --no-cache-dir --upgrade \
        pip \
        setuptools \
        wheel \
        fastapi \
        uvicorn \
        jinja2 \
        python-multipart \
        httpx \
    && pip3 uninstall -y pip setuptools wheel \
    && addgroup -S appgroup && adduser -S appuser -G appgroup \
    && mkdir -p /app/data \
    && chown -R appuser:appgroup /app

# Copy application code into the container with non-root ownership
COPY --chown=appuser:appgroup homestead/ ./homestead/
COPY --chown=appuser:appgroup inventory/ ./inventory/
COPY --chown=appuser:appgroup requirements-inventory.txt ./

# Configure persistent SQLite database path and default timezone
ENV FARM_DB_PATH=/app/data/homestead.db \
    INVENTORY_TZ=America/New_York
VOLUME ["/app/data"]

# Run as non-root user
USER appuser

# Expose the inventory service port
EXPOSE 8600

# Configure healthcheck using built-in BusyBox wget
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8600/healthz || exit 1

# Run FastAPI via uvicorn (proxy-headers enabled for Nginx / Cloudflare reverse proxy)
ENTRYPOINT [ \
    "uvicorn", "inventory.app:app", \
    "--host", "0.0.0.0", \
    "--port", "8600", \
    "--proxy-headers", \
    "--forwarded-allow-ips=*" \
]
